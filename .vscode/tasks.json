{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Mimora: install dependencies",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["ci"],
      "problemMatcher": []
    },
    {
      "label": "Mimora: dev",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "dev"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Mimora: typecheck",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "typecheck"],
      "problemMatcher": ["$tsc"],
      "group": "test"
    },
    {
      "label": "Mimora: build",
      "type": "shell",
      "command": "npm.cmd",
      "args": ["run", "build"],
      "problemMatcher": ["$tsc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
